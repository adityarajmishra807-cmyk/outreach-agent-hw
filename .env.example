# Server-side only — never expose these values in extension code.
GEMINI_API_KEY=
GEMINI_MODEL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Gemini draft generation is OFF by default.
# Enable only behind protected access. Use a unique random value of at least 24 characters.
GEMINI_DRAFTS_ENABLED=false
DRAFT_STUDIO_ACCESS_KEY=
