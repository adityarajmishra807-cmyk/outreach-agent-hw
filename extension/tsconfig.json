{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "chrome"
    ],
    "baseUrl": ".",
    "paths": {
      "@horizon/shared": [
        "../packages/shared/src/index.ts"
      ],
      "@horizon/shared/csv-import": [
        "../packages/shared/src/csv-import.ts"
      ],
      "@horizon/shared/deduplication": [
        "../packages/shared/src/deduplication.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "vite.config.ts"
  ]
}
